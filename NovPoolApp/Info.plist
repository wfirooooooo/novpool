<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>NovPool</string>
	<key>CFBundleIdentifier</key>
	<string>com.novpool.app</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>NovPool</string>
	<key>CFBundleDisplayName</key>
	<string>NovPool</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- Menu bar + floating panel utility; not shown in the Dock -->
	<key>LSUIElement</key>
	<true/>
	<!-- AppleEvents: read the active browser tab URL/title for silent provenance -->
	<key>NSAppleEventsUsageDescription</key>
	<string>NovPool needs AppleEvents to read the current browser tab’s URL and title so dropped items can record their source.</string>
	<!-- Fallback address-bar read for non-scriptable browsers (Firefox / Zen) -->
	<key>NSAccessibilityUsageDescription</key>
	<string>NovPool needs Accessibility permission to read the address bar in browsers that do not support AppleScript, so sources can be recorded.</string>
	<!-- ASWebAuthenticationSession OAuth callback (cloud connectors) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.novpool.app.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>novpool</string>
			</array>
		</dict>
	</array>
	<key>NSHumanReadableCopyright</key>
	<string>NovPool</string>
</dict>
</plist>
